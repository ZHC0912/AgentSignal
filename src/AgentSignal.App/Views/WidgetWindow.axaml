<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentSignal.App.Views"
        x:Class="AgentSignal.App.Views.WidgetWindow"
        Title="AgentSignal"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight">
  <Panel>
    <LayoutTransformControl x:Name="ScaleHost">
      <views:PillView />
    </LayoutTransformControl>
    <!-- Modal shield: while the settings window is open the widget is INERT. This transparent (but
         hit-testable) overlay sits above everything, swallowing every press before it can reach the
         buttons or start a drag; clicks are silently ignored. Invisible otherwise. -->
    <Border x:Name="ModalShield" Background="Transparent" IsVisible="False"
            PointerPressed="OnShieldPressed" PointerReleased="OnShieldReleased" />
  </Panel>
</Window>
