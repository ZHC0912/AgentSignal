<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentSignal.App.Views"
             x:Class="AgentSignal.App.Views.PillView">

  <UserControl.Styles>
    <!-- Detached pill base shared by the dots pill, the timer pill and the gear/chevron pill. Each is
         its own rounded, translucent chip. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#D90F1115" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Dots pill: fixed rounded pill. Padding is modest because each dot's glow is contained inside its
         own transparent cell (see DotsView), so nothing clips at the pill edge. -->
    <Style Selector="Border.pill.dots">
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <!-- Timer and gear pills share the rounded-chip look. The Border IS the visible pill and the
         element to size — the Button inside is transparent, chrome-less click plumbing. -->
    <Style Selector="Border.pill.timer, Border.pill.gear">
      <Setter Property="CornerRadius" Value="11" />
    </Style>

    <!-- Timer pill: CONTENT-sized, the wider of the pair — any time from 0:09 to 12:34:56 fits
         comfortably inside its padding, never clipping. (12:34:56 in Consolas 12 + this padding
         ≈ 82px, which still fits the fixed 84px reservation slot, so the dots anchor holds.)
         Applies to the strip chip AND the per-session row timers. -->
    <Style Selector="Border.pill.timer">
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="MinHeight" Value="22" />
    </Style>

    <!-- Gear and collapsed-chevron pills (both carry classes "pill gear"): compact icon buttons —
         a snug 26×26 square that just wraps the glyph (26 = the strip slot height, so the vertical
         GearMargin cluster math is untouched). Padding 0: the fixed square + the Button's centred
         content alignment do the spacing. -->
    <Style Selector="Border.pill.gear">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Flat, click-consuming button used for the timer, its chevron and the gear. Being a Button, it
         captures its own pointer press, so the window's dots-click (reveal gear) never fires for it —
         each control affects only itself. All chrome is stripped so the pill Border owns the look. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Icon glyphs (gear, chevron) rendered from an icon font. -->
    <Style Selector="Button.glyph">
      <Setter Property="Foreground" Value="#B0FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe UI Symbol, Inter" />
    </Style>
    <Style Selector="Button.glyph:pointerover">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!-- The work-time readout shown in the timer pill. Always horizontal/readable in both orientations. -->
    <Style Selector="TextBlock.timertext">
      <Setter Property="Foreground" Value="#E8FFFFFF" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- The dots block plus an attach strip (timer/chevron + gear). The strip docks to whichever edge the
       VM chose (AttachDock) — below/above the dots when horizontal, right/left when vertical — so the
       pills always open toward the screen. The dots block fills the remaining space. -->
  <DockPanel LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Top">

    <!-- Attach strip. It stretches across the dots on its cross axis, so the timer pins to one end and
         the gear to the other (left/right when horizontal; top/bottom when vertical). -->
    <Grid DockPanel.Dock="{Binding AttachDock}" Margin="{Binding AttachMargin}">
      <!-- Timer/chevron SLOT: a FIXED-size, transparent reservation. The dots pill is the anchor; only
           the element INSIDE this slot ever changes (timer chip ⇄ chevron, varying text width, or fully
           hidden). Because the slot's footprint is constant, the attach strip never resizes, so the dots
           pill can't be nudged in ANY orientation or flip direction (below/above/left/right). Reserved
           whenever the single aggregate pill is shown (!IsExpanded); the multi-session view uses its own
           per-row timers instead. Sizes are pre-scale (the whole PillView is scaled by the window). -->
      <Panel Width="84" Height="26"
             HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="{Binding TimerVertical}"
             IsVisible="{Binding !IsExpanded}">
        <!-- Timer readout (clickable → collapse). Hugs the outer edge via TimerHorizontal. -->
        <Border Classes="pill timer"
                HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="Center"
                IsVisible="{Binding IsTimerShown}">
          <Button Classes="flat" ToolTip.Tip="Hide timer" Click="OnTimerClick">
            <TextBlock Classes="timertext" Text="{Binding TimerText}" />
          </Button>
        </Border>
        <!-- Collapsed chevron (clickable → show the timer again). Sits INSIDE the reservation slot with
             the SAME alignment as the timer chip, so it appears exactly at the timer's own spot (the
             chip and the chevron simply swap in place). Being inside the fixed slot also means it can
             never change the strip's footprint, so the dots stay anchored. Direction-aware glyph (›/‹)
             unchanged. -->
        <Border Classes="pill gear"
                HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="Center"
                IsVisible="{Binding IsTimerChevronShown}">
          <!-- Chevron uses a NORMAL UI font (not the Segoe Fluent Icons glyph font the gear uses): ‹/›
               are ordinary punctuation, and that icon font has no real glyph for them, so it rendered a
               very wide fallback (~62px advance → an ~84px pill). A normal font keeps the glyph narrow
               so the pill hugs it like the gear. See CLAUDE.md A.6. -->
          <Button Classes="flat" ToolTip.Tip="Show timer" Click="OnTimerClick">
            <TextBlock Text="{Binding TimerChevronGlyph}" FontFamily="Segoe UI, Inter" FontSize="15"
                       Foreground="#B0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Border>
      </Panel>
      <!-- Settings gear (revealed by clicking the dots). Horizontal: pinned to the strip's far end,
           opposite the timer. Vertical: GearMargin drops it directly below the timer/chevron slot so
           the two pills cluster tightly beside the dots column. Strip copy only for the single
           aggregate pill — the expanded view anchors its own gear in the bottom row's band
           (horizontal) or after the last column (vertical). -->
      <Border Classes="pill gear" Margin="{Binding GearMargin}"
              HorizontalAlignment="{Binding GearHorizontal}" VerticalAlignment="{Binding GearVertical}"
              IsVisible="{Binding IsStripGearVisible}">
        <Button Classes="flat glyph" Content="&#x2699;" ToolTip.Tip="Settings" Click="OnGearClick" />
      </Border>
    </Grid>

    <!-- Dots block: the single aggregate pill, or one dots pill per session when 2+ are live. -->
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border Classes="pill dots" IsVisible="{Binding !IsExpanded}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
        <views:DotsView DataContext="{Binding}" />
      </Border>

      <!-- Expanded: one row per live session, then the settings gear attached to the END of the
           stack (below the bottom pill when horizontal, after the last column when vertical) so it
           reads as part of the stack instead of floating alone at the strip's far corner. Stack
           spacing is TIGHT (4, the single pill's cluster gap): rows sit snug against each other,
           and only a row actually showing its timer adds room below its dots (see the template). -->
      <StackPanel Orientation="{Binding SessionsStackOrientation}" Spacing="4"
                  IsVisible="{Binding IsExpanded}"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Sessions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="{Binding SessionsStackOrientation}" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- Each row carries its OWN independent timer (from that session's WorkTimer) BELOW
                   its dots in both orientations, matching the single pill. The timer slot renders
                   ONLY while that session has a timer (dynamic spacing: a hidden slot takes no
                   space, so timer-less rows sit snug against the next row; rows stay dots-top
                   aligned side-by-side because the row anchors Top and the slot hangs below).
                   Slot height 22 = the chip's MinHeight; margin 3 = the single pill's dots↔strip
                   gap (AttachMargin). -->
              <StackPanel Orientation="Vertical" Spacing="0"
                          HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border Classes="pill dots" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <views:DotsView />
                </Border>
                <!-- Chip pins LEFT under horizontal dots — matching the single pill's left-pinned
                     timer — and centres under a vertical column. Like the strip slot, the chip and
                     its collapse chevron swap IN PLACE here (same alignment, both click-consuming
                     via the shared OnTimerClick, which toggles the widget's ONE persisted collapse
                     preference — all rows and the single pill follow together). The band gates on
                     HasTimer OR ShowsGear (the LAST horizontal row carries the gear in here), so
                     the dynamic tight spacing is unchanged for plain rows whether the row currently
                     shows the chip or the chevron. -->
                <!-- Known accepted limit (vertical only): a chip WIDER than the dots pill — h:mm:ss,
                     a 1h+ session — widens its whole column by a few px (constraining the band
                     instead clips the time text, which is worse). Every m:ss/mm:ss chip is narrower
                     than the dots pill, so nothing moves in normal use. -->
                <Panel Height="22" Margin="0,3,0,0" IsVisible="{Binding IsRowBandShown}">
                  <Border Classes="pill timer" IsVisible="{Binding IsRowTimerShown}"
                          HorizontalAlignment="{Binding RowTimerHorizontal}" VerticalAlignment="Center">
                    <Button Classes="flat" ToolTip.Tip="Hide timer" Click="OnTimerClick">
                      <TextBlock Classes="timertext" Text="{Binding TimerText}" />
                    </Button>
                  </Border>
                  <!-- Height 22 overrides the gear pill's 26 so the chevron fits the row slot snugly.
                       Normal UI font, not the icon font — see the A.6 wide-fallback gotcha. Fixed '›'
                       (the timer reappears in place below the dots, so there is no direction to point
                       the way the strip chevron does). -->
                  <Border Classes="pill gear" Height="22" IsVisible="{Binding IsRowTimerChevronShown}"
                          HorizontalAlignment="{Binding RowTimerHorizontal}" VerticalAlignment="Center">
                    <Button Classes="flat" ToolTip.Tip="Show timer" Click="OnTimerClick">
                      <TextBlock Text="&#x203A;" FontFamily="Segoe UI, Inter" FontSize="15"
                                 Foreground="#B0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Border>
                  <!-- Settings gear, HORIZONTAL orientation only, LAST row only (ShowsGear — set by
                       the widget VM). Pinned RIGHT opposite the left-pinned timer — the single pill's
                       strip pattern. Living INSIDE the band makes the band its fixed anchor: the
                       timer chip/chevron appearing, disappearing or changing width can never push
                       the gear (the same reservation idea that keeps the strip dots stable). The
                       band renders whenever ShowsGear is on, so the gear sits at this exact spot
                       even when the row has no timer at all. Height 22 fits the band, like the
                       chevron above. -->
                  <Border Classes="pill gear" Height="22" IsVisible="{Binding ShowsGear}"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="flat glyph" Content="&#x2699;" ToolTip.Tip="Settings" Click="OnGearClick" />
                  </Border>
                </Panel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Gear at the stack's end — VERTICAL orientation only (IsEndGearVisible): top-aligned
             beside the last column, a spot the columns' timers can't displace (a timer only grows
             a column's height, never its width). Horizontal instead anchors the gear INSIDE the
             bottom row's band (ShowsGear above), so the last row's timer can't push it down. -->
        <Border Classes="pill gear" IsVisible="{Binding IsEndGearVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Classes="flat glyph" Content="&#x2699;" ToolTip.Tip="Settings" Click="OnGearClick" />
        </Border>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
