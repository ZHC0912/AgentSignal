<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentSignal.App.Views"
             x:Class="AgentSignal.App.Views.PillView">

  <UserControl.Styles>
    <!-- Detached pill base shared by the dots pill, the timer pill and the gear/chevron pill. Each is
         its own rounded, translucent chip. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#D90F1115" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Dots pill: fixed rounded pill. Padding is modest because each dot's glow is contained inside its
         own transparent cell (see DotsView), so nothing clips at the pill edge. -->
    <Style Selector="Border.pill.dots">
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <!-- Timer and gear pills share the rounded-chip look. The Border IS the visible pill and the
         element to size — the Button inside is transparent, chrome-less click plumbing. -->
    <Style Selector="Border.pill.timer, Border.pill.gear">
      <Setter Property="CornerRadius" Value="11" />
    </Style>

    <!-- Timer pill: CONTENT-sized, the wider of the pair — any time from 0:09 to 12:34:56 fits
         comfortably inside its padding, never clipping. (12:34:56 in Consolas 12 + this padding
         ≈ 82px, which still fits the fixed 84px reservation slot, so the dots anchor holds.)
         Applies to the strip chip AND the per-session row timers. -->
    <Style Selector="Border.pill.timer">
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="MinHeight" Value="22" />
    </Style>

    <!-- Gear and collapsed-chevron pills (both carry classes "pill gear"): compact icon buttons —
         a snug 26×26 square that just wraps the glyph (26 = the strip slot height, so the vertical
         GearMargin cluster math is untouched). Padding 0: the fixed square + the Button's centred
         content alignment do the spacing. -->
    <Style Selector="Border.pill.gear">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Flat, click-consuming button used for the timer, its chevron and the gear. Being a Button, it
         captures its own pointer press, so the window's dots-click (reveal gear) never fires for it —
         each control affects only itself. All chrome is stripped so the pill Border owns the look. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Icon glyphs (gear, chevron) rendered from an icon font. -->
    <Style Selector="Button.glyph">
      <Setter Property="Foreground" Value="#B0FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe UI Symbol, Inter" />
    </Style>
    <Style Selector="Button.glyph:pointerover">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!-- The work-time readout shown in the timer pill. Always horizontal/readable in both orientations. -->
    <Style Selector="TextBlock.timertext">
      <Setter Property="Foreground" Value="#E8FFFFFF" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- The dots block plus an attach strip (timer/chevron + gear). The strip docks to whichever edge the
       VM chose (AttachDock) — below/above the dots when horizontal, right/left when vertical — so the
       pills always open toward the screen. The dots block fills the remaining space. -->
  <DockPanel LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Top">

    <!-- Attach strip. It stretches across the dots on its cross axis, so the timer pins to one end and
         the gear to the other (left/right when horizontal; top/bottom when vertical). -->
    <Grid DockPanel.Dock="{Binding AttachDock}" Margin="{Binding AttachMargin}">
      <!-- Timer/chevron SLOT: a FIXED-size, transparent reservation. The dots pill is the anchor; only
           the element INSIDE this slot ever changes (timer chip ⇄ chevron, varying text width, or fully
           hidden). Because the slot's footprint is constant, the attach strip never resizes, so the dots
           pill can't be nudged in ANY orientation or flip direction (below/above/left/right). Reserved
           whenever the single aggregate pill is shown (!IsExpanded); the multi-session view uses its own
           per-row timers instead. Sizes are pre-scale (the whole PillView is scaled by the window). -->
      <Panel Width="84" Height="26"
             HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="{Binding TimerVertical}"
             IsVisible="{Binding !IsExpanded}">
        <!-- Timer readout (clickable → collapse). Hugs the outer edge via TimerHorizontal. -->
        <Border Classes="pill timer"
                HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="Center"
                IsVisible="{Binding IsTimerShown}">
          <Button Classes="flat" ToolTip.Tip="Hide timer" Click="OnTimerClick">
            <TextBlock Classes="timertext" Text="{Binding TimerText}" />
          </Button>
        </Border>
        <!-- Collapsed chevron (clickable → show the timer again). Sits INSIDE the reservation slot with
             the SAME alignment as the timer chip, so it appears exactly at the timer's own spot (the
             chip and the chevron simply swap in place). Being inside the fixed slot also means it can
             never change the strip's footprint, so the dots stay anchored. Direction-aware glyph (›/‹)
             unchanged. -->
        <Border Classes="pill gear"
                HorizontalAlignment="{Binding TimerHorizontal}" VerticalAlignment="Center"
                IsVisible="{Binding IsTimerChevronShown}">
          <!-- Chevron uses a NORMAL UI font (not the Segoe Fluent Icons glyph font the gear uses): ‹/›
               are ordinary punctuation, and that icon font has no real glyph for them, so it rendered a
               very wide fallback (~62px advance → an ~84px pill). A normal font keeps the glyph narrow
               so the pill hugs it like the gear. See CLAUDE.md A.6. -->
          <Button Classes="flat" ToolTip.Tip="Show timer" Click="OnTimerClick">
            <TextBlock Text="{Binding TimerChevronGlyph}" FontFamily="Segoe UI, Inter" FontSize="15"
                       Foreground="#B0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Border>
      </Panel>
      <!-- Settings gear (revealed by clicking the dots). Horizontal: pinned to the strip's far end,
           opposite the timer. Vertical: GearMargin drops it directly below the timer/chevron slot so
           the two pills cluster tightly beside the dots column. -->
      <Border Classes="pill gear" Margin="{Binding GearMargin}"
              HorizontalAlignment="{Binding GearHorizontal}" VerticalAlignment="{Binding GearVertical}"
              IsVisible="{Binding IsGearVisible}">
        <Button Classes="flat glyph" Content="&#x2699;" ToolTip.Tip="Settings" Click="OnGearClick" />
      </Border>
    </Grid>

    <!-- Dots block: the single aggregate pill, or one dots pill per session when 2+ are live. -->
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border Classes="pill dots" IsVisible="{Binding !IsExpanded}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
        <views:DotsView DataContext="{Binding}" />
      </Border>

      <!-- Expanded: one row per live session. Each row carries its OWN independent timer (from that
           session's WorkTimer) beside/below its dots, so no row's time changes when another ticks.
           The row lays dots + timer along the dots axis (timer to the right when horizontal, below
           when vertical); rows are spaced apart so each timer reads clearly and doesn't crowd. -->
      <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Sessions}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="{Binding SessionsStackOrientation}" Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="{Binding DotsOrientation}" Spacing="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Classes="pill dots" HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:DotsView />
              </Border>
              <Border Classes="pill timer" IsVisible="{Binding HasTimer}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="timertext" Text="{Binding TimerText}" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </DockPanel>
</UserControl>
